# ─── Gemini (Script Generation + AI Director Vision) ─────────────────────────
GEMINI_API_KEY=your_gemini_api_key

# ─── Fal.ai (Image Generation — Flux.1 [schnell]) ────────────────────────────
FAL_KEY=your_fal_ai_api_key

# ─── TTS (Narration Audio) ────────────────────────────────────────────────────
# Provider: "elevenlabs" (default) | "openai"
TTS_PROVIDER=elevenlabs
TTS_API_KEY=your_tts_api_key

# ElevenLabs specific (only if TTS_PROVIDER=elevenlabs)
ELEVENLABS_VOICE_ID=pNInz6obpgDQGcFmaJgB   # Adam — deep, documentary voice

# OpenAI TTS specific (only if TTS_PROVIDER=openai)
# OPENAI_TTS_VOICE=onyx

# ─── Music (Background Track) ────────────────────────────────────────────────
# Provider: "ffmpeg" (default, no API needed) | "api" (custom HTTP endpoint)
MUSIC_PROVIDER=ffmpeg

# Required only if MUSIC_PROVIDER=api:
# MUSIC_API_URL=https://your-music-api.example.com/generate
# MUSIC_API_KEY=your_music_api_key

# ─── FFmpeg ───────────────────────────────────────────────────────────────────
# Override with a system FFmpeg binary compiled with NVENC support.
# Required for h264_nvenc hardware encoding (RTX 4060 etc).
# Download from: https://www.gyan.dev/ffmpeg/builds/ (Windows, full build)
# FFMPEG_PATH=C:\ffmpeg\bin\ffmpeg.exe
# FFPROBE_PATH=C:\ffmpeg\bin\ffprobe.exe
